# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
pip-wheel-metadata/
.venv/
venv/
env/
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.ipynb_checkpoints/

# ── PySide6 / Qt build output ───────────────────────────────
*.qmlc
*.jsc
rc_*.py

# ── g.Pype runs: raw EEG, recordings, calibration ───────────
# Never commit raw EEG. Share recordings privately, label them Recorded.
recordings/
**/recordings/
eeg-recordings/
**/eeg-raw/
*.edf
*.bdf
*.gdf
*.xdf
*.fif
*.mat
*.h5
*.hdf5
*.npy
*.npz
# Trained per-wearer classifiers (#46) and g.Pype session logs
models/
*.pkl
*.joblib
*.log
logs/

# ── Data: keep curated demo assets, ignore bulk downloads ───
# Commit only the small verified files under data/openorbit/ (#29).
data/**/raw/
data/**/downloads/
*.zip
*.rar
*.tmp

# ── Secrets and local config ────────────────────────────────
.env
.env.*
!.env.example
secrets.*
*.pem
*.key
*.pfx
# AI provider keys (#27) belong in .env, never in code

# ── IDEs and editors ────────────────────────────────────────
.vs/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.user
*.suo
*.swp

# ── OS ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── Demo captures (share via drive, not git) ────────────────
*.mp4
*.mov
*.mkv

# ── Claude Code local settings ──────────────────────────────
.claude/settings.local.json

# Claude Code agent worktrees
.claude/worktrees/
