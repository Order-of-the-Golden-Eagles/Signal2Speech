#!/bin/sh
# Signal2Speech pre-push: run the test suite (~30 s) before anything leaves your machine.
# Enable once per clone:  git config core.hooksPath .githooks
# Skip once (docs-only push, emergencies):  SKIP_TESTS=1 git push   or   git push --no-verify
set -e

[ "${SKIP_TESTS:-0}" = "1" ] && { echo "⚠️  pre-push tests skipped (SKIP_TESTS=1)"; exit 0; }

# Git passes "<local ref> <local sha> <remote ref> <remote sha>" per ref on stdin.
# A deletion has an all-zero local sha; skip tests when every ref is a deletion.
pushes_code=0
while read -r _lref lsha _rref _rsha; do
  case "$lsha" in *[!0]*) pushes_code=1 ;; esac
done
[ "$pushes_code" = "0" ] && { echo "pre-push: branch deletion only, skipping tests"; exit 0; }

root="$(git rev-parse --show-toplevel)"
cd "$root"

# Prefer the project venv so hooks use the same interpreter as the team.
if   [ -x ".venv/Scripts/python.exe" ]; then py=".venv/Scripts/python.exe"
elif [ -x ".venv/bin/python" ];        then py=".venv/bin/python"
else py="$(command -v python3 || command -v python)"
fi

echo "🧪 pre-push: running pytest with $py ..."
if QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-offscreen}" "$py" -m pytest -q -p no:cacheprovider; then
  echo "✅ Tests passed."
else
  echo "❌ Tests failed. Fix them, or skip once with SKIP_TESTS=1 git push"
  exit 1
fi
