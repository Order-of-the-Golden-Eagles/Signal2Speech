#!/bin/sh
# Signal2Speech pre-push: a quick check on every push, and the full test suite only when the
# pushed commits change code (docs, the devlog and images skip it).
# Enable once per clone:  git config core.hooksPath .githooks
# Skip once (emergencies):  SKIP_TESTS=1 git push   or   git push --no-verify
set -e

[ "${SKIP_TESTS:-0}" = "1" ] && { echo "⚠️  pre-push tests skipped (SKIP_TESTS=1)"; exit 0; }

zeros="0000000000000000000000000000000000000000"
# Git passes "<local ref> <local sha> <remote ref> <remote sha>" per ref on stdin.
# A deletion has an all-zero local sha; skip everything when every ref is a deletion.
pushes_code=0
changed=""
while read -r _lref lsha _rref rsha; do
  case "$lsha" in *[!0]*) ;; *) continue ;; esac
  pushes_code=1
  if [ "$rsha" = "$zeros" ] || ! git cat-file -e "$rsha^{commit}" 2>/dev/null; then
    # New branch (or the remote tip isn't here): compare with where it left main.
    base="$(git merge-base "$lsha" origin/main 2>/dev/null || true)"
  else
    base="$rsha"
  fi
  if [ -n "$base" ]; then
    changed="$changed
$(git diff --name-only "$base" "$lsha" 2>/dev/null || true)"
  else
    changed="$changed
unknown-base.py"      # can't tell what changed, so treat it as code
  fi
done
[ "$pushes_code" = "0" ] && { echo "pre-push: branch deletion only, skipping tests"; exit 0; }

root="$(git rev-parse --show-toplevel)"
cd "$root"
# Git exports GIT_DIR and friends to hooks. Drop them, so tests or tools that run git in a
# subprocess (tests/test_githooks.py did) can't write into this repo by accident.
unset $(git rev-parse --local-env-vars)

# Prefer the project venv so hooks use the same interpreter as the team.
if   [ -x ".venv/Scripts/python.exe" ]; then py=".venv/Scripts/python.exe"
elif [ -x ".venv/bin/python" ];        then py=".venv/bin/python"
else py="$(command -v python3 || command -v python)"
fi

needs_tests=true
if [ -f tools/quick_check.py ]; then
  if ! "$py" tools/quick_check.py; then
    echo "❌ Quick checks failed (see above). Fix them, or skip once with SKIP_TESTS=1 git push"
    exit 1
  fi
  needs_tests="$(printf '%s\n' "$changed" | "$py" tools/quick_check.py --needs-tests)"
fi

if [ "$needs_tests" != "true" ]; then
  echo "✅ Docs-only push: quick checks passed, test suite skipped."
  exit 0
fi

echo "🧪 pre-push: running pytest with $py ..."
if QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-offscreen}" "$py" -m pytest -q -p no:cacheprovider; then
  echo "✅ Tests passed."
else
  echo "❌ Tests failed. Fix them, or skip once with SKIP_TESTS=1 git push"
  exit 1
fi
